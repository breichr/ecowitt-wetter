# Anzeige-Name der Station (Seitentitel, Überschrift, PWA-Name)
STATION_NAME=Meine Wetterstation
# Seehöhe in Metern (Kopfzeile des Klimadiagramms)
STATION_ELEVATION_M=0
# PASSKEY der Station. Leer = keine Authentifizierung am /ecowitt-Endpoint.
ECOWITT_PASSKEY=
# Erlaubte CORS-Origins für /api/* (kommagetrennt). * = alle, leer = CORS aus.
CORS_ORIGINS=*
# Optionaler getrennter Hostname nur für Station-Uploads (dort nur POST /ecowitt).
INGEST_HOST=
# Zeitzone für Lokalzeit-Zeitstempel und Tages-/Monats-/Jahresgrenzen
TZ=Europe/Vienna
# Nur für lokalen Betrieb außerhalb von Docker
# DATABASE_PATH=./data/wetterdaten.db
# PORT=3000
